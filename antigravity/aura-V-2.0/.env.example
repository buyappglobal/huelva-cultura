# Aura Business V2.0 - Configuración de Entorno

# URL del Stream Engine (WebSockets + API)
VITE_STREAM_ENGINE_WS_URL=wss://aura-central-stream-engine-xxxx.run.app
VITE_STREAM_ENGINE_API_URL=https://aura-central-stream-engine-xxxx.run.app

# Clave de seguridad del Stream Engine (Backend proxy)
# Debe coincidir con la definida en el backend FastAPI
STREAM_ENGINE_API_KEY=

# Clave de seguridad para la comunicación Cloudflare -> Google
# Cámbiala por una cadena aleatoria larga
AURA_SECRET_KEY=

# Cloudflare R2 Connection (S3 Compatible)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=aura-media

# Firebase Admin (Opcional si se despliega en Google Cloud con service accounts)
# FIREBASE_CONFIG=
